<?xml version="1.0" encoding="utf-8"?>
<!-- Keep official data on this device only: exclude everything from cloud backup and device transfer.
     Use the app's own Backup / Restore in Settings instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
